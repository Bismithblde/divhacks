# Server-only provider configuration. Never expose these values to the browser.
OTP_BASE_URL=http://localhost:8080
MTA_BUS_TIME_API_KEY=
MTA_GTFS_REALTIME_API_KEY=
ORS_API_KEY=

# Optional server-side explanation provider. Deterministic explanations remain
# available when this is unset.
GEMINI_API_KEY=

# Optional server-side voice for transit arrival check-ins. Browser speech is
# used when ElevenLabs is unavailable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Browser-safe Supabase project configuration. Required for sign-in and sign-up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
